{
  "name": "historical-gantus",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:static": "vite --mode static --port 3001",
    "build:static": "npm run type-check && vite build --mode static",
    "preview:static": "vite preview --mode static --port 4173",
    "snapshot:export": "node --experimental-strip-types scripts/export-static.ts",
    "test:static": "node --experimental-strip-types --test tests/static.test.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test:graph": "node --experimental-strip-types --test tests/graph.test.mjs",
    "test:family": "node --experimental-strip-types --test tests/familyForm.test.mjs",
    "test:gender": "node --experimental-strip-types --test tests/gender.test.mjs",
    "test:countries": "node --experimental-strip-types --test tests/countries.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mdi/font": "7.4.47",
    "vue": "^3.5.30",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "@vuetify/mcp": "^0.5.0"
  }
}
